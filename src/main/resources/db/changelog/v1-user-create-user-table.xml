<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="002-create-user-account" author="anshu">

        <!-- ========================= -->
        <!-- Create user_account Table -->
        <!-- ========================= -->

        <createTable tableName="user_account" schemaName="users">

            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"
                             primaryKeyName="pk_user_account"
                             nullable="false"/>
            </column>

            <column name="uuid" type="UUID">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uk_user_account_uuid"/>
            </column>

            <column name="full_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="email" type="VARCHAR(150)">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uk_user_account_email"/>
            </column>

            <column name="phone_number" type="VARCHAR(20)"/>

            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="role" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="house_uuid" type="UUID"/>

            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="updated_at"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

        </createTable>

        <!-- ========================= -->
        <!-- Indexes -->
        <!-- ========================= -->

        <createIndex indexName="idx_user_house_uuid"
                     tableName="user_account"
                     schemaName="users">
            <column name="house_uuid"/>
        </createIndex>

        <createIndex indexName="idx_user_phone"
                     tableName="user_account"
                     schemaName="users">
            <column name="phone_number"/>
        </createIndex>

        <!-- ========================= -->
        <!-- Check Constraints (SQL Based - Stable) -->
        <!-- ========================= -->

        <sql>
            ALTER TABLE users.user_account
            ADD CONSTRAINT chk_user_status
            CHECK (status IN ('ACTIVE','BLOCKED'));
        </sql>

        <sql>
            ALTER TABLE users.user_account
            ADD CONSTRAINT chk_user_role
            CHECK (role IN ('ADMIN','USER'));
        </sql>

    </changeSet>

</databaseChangeLog>
